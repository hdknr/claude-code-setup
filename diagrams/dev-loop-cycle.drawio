<mxfile host="app.diagrams.net" modified="2026-07-30T00:00:00.000Z" agent="Claude Code" version="24.0.0">
  <diagram name="dev-loop 標準ループ" id="dev-loop-cycle">
    <!--
      レイアウトの意図: mkdocs-material のコンテンツ幅（約 690px）で等倍表示されるよう
      キャンバスを 720px 幅に収めている。横長にすると縮小されてラベルが読めなくなる（#40）。
      2 列 × 5 行のスネークフローで 9 ノードを配置する。
    -->
    <mxGraphModel dx="720" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="720" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="dev-loop — 1 Issue = 1 周の標準ループ" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="130" y="15" width="460" height="34" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="停止条件は verify。通らなければ実装へ戻る。" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="160" y="50" width="400" height="22" as="geometry" />
        </mxCell>

        <!-- ============ Phase 1: 準備 ============ -->
        <mxCell id="p1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;dashed=0;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="85" width="680" height="252" as="geometry" />
        </mxCell>
        <!--
          フェーズラベルは短く保ち、説明は右半分に分ける。キャリッジリターンのエッジが
          x=200 で降りてくるため、ラベルをそこまで伸ばすと矢印が文字を貫く。
        -->
        <mxCell id="p1_label" value="① 準備" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="38" y="92" width="120" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p1_note" value="何を作るか決める" style="text;html=1;align=right;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="380" y="93" width="290" height="24" as="geometry" />
        </mxCell>

        <mxCell id="n1" value="&lt;b&gt;1. Issue 選択&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;gh issue view &amp;lt;issue&amp;gt;&lt;br&gt;要件・受入条件・関連 PR を把握&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFB300;fontSize=14;fontColor=#333333;arcSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="125" width="300" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;2. 文脈収集&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;設計・既存実装・過去の議論を読む&lt;br&gt;受入条件を目視項目へ翻訳する&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFB300;fontSize=14;fontColor=#333333;arcSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="125" width="300" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;3. 計画&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;変更範囲・デプロイ経路を確定&lt;br&gt;&lt;b&gt;計画と受入基準をファイルに残す&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FFB300;fontSize=14;fontColor=#333333;arcSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="235" width="300" height="88" as="geometry" />
        </mxCell>

        <!-- worktree: 番号なしの必須ゲート -->
        <mxCell id="gate" value="&lt;b&gt;🌿 worktree 開始&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;PR を出す変更は&lt;b&gt;必須&lt;/b&gt;&lt;br&gt;ファイルを 1 行も触る前に入る&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E65100;strokeWidth=2;dashed=1;fontSize=14;fontColor=#333333;arcSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="235" width="300" height="88" as="geometry" />
        </mxCell>

        <!-- ============ Phase 2: ループの本体 ============ -->
        <mxCell id="p2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#7E57C2;dashed=0;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="357" width="680" height="175" as="geometry" />
        </mxCell>
        <mxCell id="p2_label" value="② ループの本体" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;fontColor=#4527A0;" vertex="1" parent="1">
          <mxGeometry x="38" y="364" width="150" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p2_note" value="verify が通るまで反復。「テストが緑」では完了にしない" style="text;html=1;align=right;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#4527A0;" vertex="1" parent="1">
          <mxGeometry x="330" y="365" width="340" height="24" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="&lt;b&gt;4. 実装&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;CLAUDE.md のルールに従う&lt;br&gt;既存コードの流儀に合わせる&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#9575CD;fontSize=14;fontColor=#333333;arcSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="395" width="300" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;5. 検証（停止条件）👤&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;実機で目視 ／ 別モデル Verifier&lt;br&gt;計画ファイルの受入基準で判定&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1C4E9;strokeColor=#5E35B1;strokeWidth=2;fontSize=14;fontColor=#333333;arcSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="395" width="300" height="88" as="geometry" />
        </mxCell>

        <!-- ============ Phase 3: 仕上げ ============ -->
        <mxCell id="p3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#2196F3;dashed=0;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="552" width="680" height="252" as="geometry" />
        </mxCell>
        <mxCell id="p3_label" value="③ 仕上げ" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;fontStyle=1;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="38" y="559" width="130" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p3_note" value="反映して次の周を賢くする" style="text;html=1;align=right;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;fontColor=#0D47A1;" vertex="1" parent="1">
          <mxGeometry x="380" y="560" width="290" height="24" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="&lt;b&gt;6. レビュー → PR 👤&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;/code-review で差分を見る&lt;br&gt;レビュー結果を PR コメントに残す&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;fontSize=14;fontColor=#333333;arcSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="595" width="300" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;7. 本番反映 👤&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;CLAUDE.md ／ deploy runbook に従う&lt;br&gt;不可逆な操作は人間の承認を得る&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;fontSize=14;fontColor=#333333;arcSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="370" y="595" width="300" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;8. 経験の還元&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px;color:#666666&quot;&gt;学びを CLAUDE.md・Skill・メモリへ&lt;br&gt;焼き戻してから周を閉じる&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#64B5F6;fontSize=14;fontColor=#333333;arcSize=12;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="705" width="300" height="88" as="geometry" />
        </mxCell>

        <!-- ============ Edges: Phase 1 ============ -->
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#FF9800;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="n1" target="n2" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#FF9800;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="n2" target="n3" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="224" />
              <mxPoint x="200" y="224" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3gate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E65100;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="n3" target="gate" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- gate -> 実装 -->
        <mxCell id="egate4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="gate" target="n4" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="345" />
              <mxPoint x="200" y="345" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ============ Edges: Phase 2 (the loop body) ============ -->
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#5E35B1;strokeWidth=3;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="n4" target="n5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e54" value="NG" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#E53935;strokeWidth=3;exitX=0.25;exitY=1;entryX=0.75;entryY=1;fontSize=13;fontStyle=1;fontColor=#C62828;labelBackgroundColor=#EDE7F6;" edge="1" source="n5" target="n4" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="445" y="508" />
              <mxPoint x="275" y="508" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- 検証 OK -> レビュー -->
        <mxCell id="e56" value="OK" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2E7D32;strokeWidth=2;exitX=0.75;exitY=1;entryX=0.5;entryY=0;fontSize=13;fontStyle=1;fontColor=#2E7D32;labelBackgroundColor=#FFFFFF;" edge="1" source="n5" target="n6" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="595" y="542" />
              <mxPoint x="200" y="542" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ============ Edges: Phase 3 ============ -->
        <mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2196F3;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="n6" target="n7" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e78" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#2196F3;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="n7" target="n8" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="520" y="694" />
              <mxPoint x="200" y="694" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ============ 次の周へ ============ -->
        <!--
          ラベルはエッジに付けない。エッジの中点は左端の縦走 (x=10) にあり、
          そこに置くとキャンバス外へはみ出して文字が切れる。独立したテキストで置く。
        -->
        <mxCell id="e81" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#7E57C2;strokeWidth=2;dashed=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" source="n8" target="n1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="838" />
              <mxPoint x="10" y="838" />
              <mxPoint x="10" y="169" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e81_label" value="次の周へ" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=13;fontStyle=1;fontColor=#4527A0;" vertex="1" parent="1">
          <mxGeometry x="60" y="806" width="100" height="22" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="👤 = 人間の承認が挟まるポイント　／　🌿 破線 = ファイルを触る前の必須ゲート" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="862" width="600" height="22" as="geometry" />
